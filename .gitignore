frontend/assets/js/config.js

# Pastas de build (caso use bundlers no futuro)
frontend/dist/
frontend/build/

# --- BACKEND ---
# Uploads de arquivos
backend/uploads/
uploads/

# Logs específicos
backend/logs/

# Build outputs do backend
backend/dist/
backend/build/
backend/coverage/

# Arquivos específicos do projeto antigo/exemplos
/Example/*
busstop.mongodb.js

# Arquivos de debug npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
